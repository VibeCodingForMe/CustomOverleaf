{
  "name": "latex-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Local-first LaTeX desktop editor for macOS",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "desktop": "tauri dev --no-watch",
    "desktop:build": "tauri build --debug",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:rust"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "codemirror": "6.0.2",
    "i18next": "26.5.11",
    "katex": "^0.16.22",
    "lucide-react": "1.62.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-i18next": "17.1.9",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.2",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/react": "16.3.3",
    "@types/katex": "^0.16.7",
    "@types/node": "^24.19.2",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vite": "7.1.7",
    "vitest": "3.2.4"
  }
}
